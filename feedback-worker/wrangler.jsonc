{
  "name": "finbridge-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "GITHUB_REPO": "nikunjsb/finbridge-feedback",
    "ALLOWED_ORIGIN": "https://nikunjsb.github.io"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
